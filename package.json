{
  "name": "pixiv-filter-for-wxt",
  "description": "PixivでNG登録したユーザーやタグの作品を非表示にします。",
  "private": true,
  "version": "1.7.3",
  "type": "module",
  "scripts": {
    "dev": "pnpm wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:brave": "wxt -b brave",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "esbuild": "node esbuild.config.mjs",
    "test": "pnpm build && playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@wxt-dev/module-react": "^1.2.2",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wxt": "^0.21.5"
  }
}
